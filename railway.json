{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watchPatterns": [
      "api/**",
      "configs/**",
      "database/**",
      "management/**",
      "migrations/**",
      "monitoring/**",
      "prompts/**",
      "scrapers/**",
      "services/**",
      "utils/**",
      "config.py",
      "nixpacks.toml",
      "Procfile",
      "pyproject.toml",
      "railway*.json",
      "start.sh",
      "uv.lock"
    ]
  },
  "deploy": {
    "startCommand": "bash start.sh",
    "restartPolicyType": "NEVER"
  }
}
