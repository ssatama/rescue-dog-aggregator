# Environment variables for development
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_R2_CUSTOM_DOMAIN=your-r2-public-domain.com
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
# PostHog project token (public, write-only). Capture runs in production only;
# add ?debug=posthog to a URL to try it locally.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
