{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watchPatterns": [
      "api/**",
      "configs/**",
      "database/**",
      "migrations/**",
      "monitoring/**",
      "services/**",
      "utils/**",
      "config.py",
      "nixpacks.toml",
      "Procfile",
      "pyproject.toml",
      "railway*.json",
      "start.sh",
      "uv.lock"
    ]
  },
  "deploy": {
    "startCommand": "bash start.sh",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "overlapSeconds": 30,
    "restartPolicyType": "ON_FAILURE"
  }
}
